# Plantilla de C:\Jarvis-secrets\.env. instalar.cmd la copia a C:\Jarvis-secrets\.env.example.
# Copia ese archivo a .env (en la misma carpeta, fuera del repo) y rellena los valores.
# Nunca pongas valores reales en este archivo del repo.

# Obligatoria
ANTHROPIC_API_KEY=

# Búsqueda web (opcional; sin ella, Wikipedia y DuckDuckGo)
TAVILY_API_KEY=

# Voz (opcional): piper (local, por defecto) o elevenlabs
JARVIS_TTS=piper
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# GitHub para el briefing (opcional): token fine-grained de solo lectura
GITHUB_TOKEN=
JARVIS_GITHUB_REPOS=

# Comportamiento (opcional; estos son los valores por defecto)
JARVIS_STREAMING=1
JARVIS_LOG_TEXTO=1
JARVIS_BRIEFING=1
JARVIS_MEMORIA_DIAS=90
# Gate estricto: vacío = 7 tools con confirmación (por defecto); 1 = las 9; 0 = ninguna
JARVIS_GATE_ESTRICTO=

# Avisos proactivos de CI en rojo (opcional; necesitan GITHUB_TOKEN)
JARVIS_AVISOS_CI=0
JARVIS_AVISOS_CI_MIN=5
JARVIS_AVISOS_CI_REPOS=

# Modo degradado: segundos sin Ollama tras un fallo; 0 = sin voz de Windows si falla Piper
JARVIS_OLLAMA_PAUSA_S=300
# Modelo de Ollama para respuestas locales y resumen de memoria; vacío = qwen2.5:3b (tiene que estar descargado)
#JARVIS_OLLAMA_MODELO=
JARVIS_VOZ_EMERGENCIA=1
